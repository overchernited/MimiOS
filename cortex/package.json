{
  "name": "cortex",
  "exports": {
    "./ui/theme.css": "./src/lib/melanin-ui/theme.css"
  },
  "private": true,
  "version": "1.0.0",
  "description": "MimiOS Cortex desktop app",
  "homepage": "https://github.com/overchernited/MimiOS",
  "author": {
    "name": "marlon",
    "email": "mmarlon.ssantiago@gmail.com"
  },
  "type": "module",
  "main": "electron/.build/main.mjs",
  "scripts": {
    "dev": "vite --port 3000 --host",
    "build": "vite build",
    "preview": "vite preview",
    "start": "tsx server.ts",
    "serve": "pnpm build && pnpm start",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "build:electron": "esbuild electron/main.ts --bundle --format=esm --platform=node --packages=external --outfile=electron/.build/main.mjs --target=node22",
    "electron:dev": "pnpm build:electron && cross-env VITE_DEV_SERVER_URL=http://localhost:3000 electron .",
    "electron": "pnpm build && pnpm build:electron && electron .",
    "dist:linux": "pnpm build && pnpm build:electron && electron-builder --linux",
    "dist:win": "pnpm build && pnpm build:electron && electron-builder --win",
    "dist:mac": "pnpm build && pnpm build:electron && electron-builder --mac",
    "dist": "pnpm build && pnpm build:electron && electron-builder"
  },
  "build": {
    "appId": "com.mimios.cortex",
    "productName": "MimiOS Cortex",
    "asar": true,
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "electron/.build/**",
      "dist/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "publish": {
      "provider": "github",
      "owner": "overchernited",
      "repo": "MimiOS"
    }
  },
  "devDependencies": {
    "@lucide/svelte": "^1.24.0",
    "@supabase/supabase-js": "^2.112.2",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.2",
    "@types/ws": "^8.18.1",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "gsap": "^3.15.0",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "dependencies": {
    "ws": "^8.21.1"
  }
}
